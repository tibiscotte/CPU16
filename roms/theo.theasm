.draw_first_char:
    int val 12

    mov reg val c 0
    int val 11

    mov reg val a 39
    int val 10

    mov reg val c 1
    int val 11

    xor reg reg a a
    mov reg reg b a
    mov reg val d 0

    int val 1
    jmp .loop

.loop:
    int val 4
    cmp reg val a 1
    jie .key_pressed
    jmp .loop

.key_pressed:
    mov reg reg a b
    cmp reg val a 43
    jie .backspace
    cmp reg val a 45
    jie .enter
    jne .printable_char

.printable_char:
    cmp reg val d 10
    jie .loop
    inc reg d
    int val 11
    int val 10
    int val 1
    ldram ptr reg d a
    xor reg reg a a
    inc reg c
    jmp .loop

.backspace:
    cmp reg val d 0
    jie .loop
    dec reg c
    ldram ptr val d 0
    dec reg d
    int val 11
    int val 10
    int val 1
    xor reg reg a a
    jmp .loop

.enter:
    xor reg reg d d
    xor reg reg c c
    int val 12
    int val 1
    jmp .reset_char

.reset_char:
    cmp reg val d 11
    jig .draw_first_char
    ldram ptr val d 0
    inc reg d
    jmp .reset_char

hlt