.loop:
    int val 4
    cmp reg val a 1
    jie .key_pressed
    jmp .loop

.key_pressed:
    mov reg reg a b
    cmp reg val a 43
    jie .backspace
    cmp reg val a 45
    jie .enter
    jne .printable_char

.printable_char:
    cmp reg val d 10
    jie .loop
    inc reg d
    int val 11
    int val 10
    int val 1
    xor reg reg a a
    inc reg c
    jmp .loop

.backspace:
    dec reg c
    dec reg d
    int val 11
    int val 10
    int val 1
    xor reg reg a a
    jmp .loop

.enter:
    xor reg reg d d
    xor reg reg c c
    int val 12
    int val 1
    jmp .loop

hlt